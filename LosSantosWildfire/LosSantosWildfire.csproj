<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bibliothèque .NET Framework 4.8 chargée par ScriptHookVDotNet v3. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>LosSantosWildfire</AssemblyName>
    <RootNamespace>LosSantosWildfire</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- API ScriptHookVDotNet v3 (seulement pour compiler : la DLL est fournie par SHVDN en jeu). -->
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" ExcludeAssets="runtime" />
    <!-- Permet de compiler net48 hors Windows / sans Visual Studio. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LosSantosWildfire.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
